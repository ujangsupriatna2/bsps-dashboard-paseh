// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BspsData {
  id         String   @id @default(cuid())
  nama       String
  nik        String?
  kk         String?
  alamat     String?
  kecamatan  String   @default("Paseh")
  desa       String   @default("Loa")
  rt         String?
  rw         String?
  lat        Float
  lng        Float
  kategori   String   // data_awal, data_susulan, layak_huni, data_cadangan
  keterangan String? // layak huni details, susulan info, etc.
  folderPath String? // path to documentation photos folder
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
